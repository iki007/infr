#version 460
// XMX flash-attention for PREFILL on Intel Xe2 (8x16x16 f16 cooperative matrices, 16-lane
// subgroups) — the coopmat counterpart of `attn_nc_fa.comp`, with its exact interface: the same
// push constants, bindings and semantics (causal, sliding window, ring KV rows, GQA, caller scale,
// q/dst rows NOT padded). The 16x16x16 flash kernels (attn_flash*.comp) need a fragment shape and
// a 32-lane subgroup this device does not have, and hd=256 (qwen35) exceeds their fixed hd=128.
//
// Tile: BM=32 query rows of one head per workgroup, BN=32 keys per block, 128 threads = 8
// subgroups. Per block:
//   1. K block -> KVs (f16, zero-filled past kv_len), barrier.
//   2. S = Q·Kᵀ: 8 warps x one 8x16 S fragment each (HD/16 k-steps, Q from Qs staged once),
//      stored to Ss (f32), barrier.
//   3. V block -> KVs; one thread per row: mask, online softmax, P (f16) -> Ps, rescale factor.
//      barrier.
//   4. O += P·V: each warp owns rows [mi*8, +8) x HD/2 dims as HD/32 accumulator fragments, in
//      REGISTERS for the whole kv loop. The per-row rescale needs each accumulator element's row:
//      the element mapping of a coopmat is implementation-defined, so it is read once at the top
//      from a probe matrix (element (r, c) = r, resp. c) loaded into an accumulator.
//      barrier.
// Rows and columns of the output come from the same probe, so the final normalized O is written
// element-wise straight to global with the q_len bound.
//
// Requires requiredSubgroupSize=16 and the 8x16x16 f16 coopmat shape. -DHD=128|256.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : require

#ifndef HD
#define HD 256u
#endif
const uint BM = 32u;
const uint BN = 32u;
const uint THREADS = 128u;
const uint DPW = HD / 2u;           // dims per warp in the PV phase
const uint NF = DPW / 16u;          // O fragments per warp (8 at hd=256, 4 at hd=128)
const uint QS4 = HD / 4u + 2u;      // Qs/KVs row pitch in f16vec4s (+2: de-conflict)

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint q_len;
    uint kv_len;
    uint nh;
    uint nkv;
    uint hd;
    uint pos;
    uint window;
    float scale;
    uint cap;
} pc;
layout(binding = 0) readonly buffer QB { f16vec4 q4[]; }; // [q_len, nh, hd]
layout(binding = 1) readonly buffer KB { f16vec4 k4[]; }; // [rcap, nkv, hd]
layout(binding = 2) readonly buffer VB { f16vec4 v4[]; }; // [rcap, nkv, hd]
layout(binding = 3) writeonly buffer OB { float o[]; };   // [q_len, nh, hd]

shared f16vec4 Qs[BM * QS4];
shared f16vec4 KVs[BN * QS4];
shared float Ss[BM * BN];
shared float16_t Ps[BM * BN];
shared float mrow[BM];
shared float lrow[BM];
shared float corr[BM];
shared float probe[8u * 16u];

void main() {
    uint qt = gl_WorkGroupID.x / pc.nh;
    uint h = gl_WorkGroupID.x % pc.nh;
    uint qr0 = qt * BM;
    uint kvh = h / (pc.nh / pc.nkv);
    uint li = gl_LocalInvocationIndex;
    uint warp = gl_SubgroupID;
    const uint hd4 = HD / 4u;
    float scale = pc.scale > 0.0 ? pc.scale : 1.0 / sqrt(float(HD));
    uint rcap = (pc.cap > 0u) ? pc.cap / (pc.nkv * HD) : 0u;
#define RROW(j) ((rcap > 0u) ? ((j) % rcap) : (j))

    // Q tile -> Qs (zeros past q_len), running stats, and the row probe.
    for (uint idx = li; idx < BM * hd4; idx += THREADS) {
        uint r = idx / hd4;
        uint c4 = idx % hd4;
        uint gr = qr0 + r;
        Qs[r * QS4 + c4] = (gr < pc.q_len) ? q4[(gr * pc.nh + h) * hd4 + c4] : f16vec4(0.0);
    }
    if (li < BM) {
        mrow[li] = -1e30;
        lrow[li] = 0.0;
    }
    probe[li] = float(li / 16u); // row index of element (li/16, li%16) of an 8x16 matrix
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> rmapm;
    coopMatLoad(rmapm, probe, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    probe[li] = float(li % 16u);
    barrier();
    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> cmapm;
    coopMatLoad(cmapm, probe, 0, 16, gl_CooperativeMatrixLayoutRowMajor);

    // This warp's QK fragment (S rows si*8.., keys sj*16..) and PV slice (rows mi*8.., dims
    // dh*DPW..).
    uint si = warp / 2u;
    uint sj = warp % 2u;
    uint mi = warp / 2u;
    uint dh = warp % 2u;
    coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> oacc[NF];
    [[unroll]] for (uint f = 0u; f < NF; f++) {
        oacc[f] = coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
    }

    uint lo_tile = (pc.window > 0u && pc.pos + qr0 + 1u > pc.window)
                       ? pc.pos + qr0 + 1u - pc.window
                       : 0u;
    lo_tile = (lo_tile / BN) * BN;
    uint kvend = min(pc.kv_len, pc.pos + qr0 + BM);

    for (uint b0 = lo_tile; b0 < kvend; b0 += BN) {
        // 1. K block
        for (uint idx = li; idx < BN * hd4; idx += THREADS) {
            uint j = idx / hd4;
            uint c4 = idx % hd4;
            uint kpos = b0 + j;
            KVs[j * QS4 + c4] = (kpos < pc.kv_len) ? k4[(RROW(kpos) * pc.nkv + kvh) * hd4 + c4]
                                                   : f16vec4(0.0);
        }
        barrier();
        // 2. S fragment
        coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator> sacc =
            coopmat<float, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>(0.0);
        [[unroll]] for (uint kf = 0u; kf < HD; kf += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> qf;
            coopMatLoad(qf, Qs, si * 8u * QS4 + kf / 4u, QS4, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> kf_;
            coopMatLoad(kf_, KVs, sj * 16u * QS4 + kf / 4u, QS4,
                        gl_CooperativeMatrixLayoutColumnMajor);
            sacc = coopMatMulAdd(qf, kf_, sacc);
        }
        coopMatStore(sacc, Ss, si * 8u * BN + sj * 16u, BN, gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        // 3. V block (K is consumed) + online softmax, one thread per row
        for (uint idx = li; idx < BN * hd4; idx += THREADS) {
            uint j = idx / hd4;
            uint c4 = idx % hd4;
            uint kpos = b0 + j;
            KVs[j * QS4 + c4] = (kpos < pc.kv_len) ? v4[(RROW(kpos) * pc.nkv + kvh) * hd4 + c4]
                                                   : f16vec4(0.0);
        }
        {
            // 4 adjacent lanes per row, 8 keys each; the row max and sum reduce over the 4-lane
            // cluster.
            uint row = li / 4u;
            uint j0 = (li % 4u) * 8u;
            uint qpos = pc.pos + qr0 + row;
            uint lo_r = (pc.window > 0u && qpos + 1u > pc.window) ? qpos + 1u - pc.window : 0u;
            float sv[8];
            float lmax = -1e30;
            [[unroll]] for (uint j = 0u; j < 8u; j++) {
                uint kpos = b0 + j0 + j;
                bool dead = kpos >= pc.kv_len || kpos > qpos || kpos < lo_r;
                sv[j] = dead ? -1e30 : Ss[row * BN + j0 + j] * scale;
                lmax = max(lmax, sv[j]);
            }
            float mold = mrow[row];
            float rmax = max(mold, subgroupClusteredMax(lmax, 4u));
            float lsum = 0.0;
            [[unroll]] for (uint j = 0u; j < 8u; j++) {
                float p = (sv[j] > -1e29) ? exp(sv[j] - rmax) : 0.0;
                Ps[row * BN + j0 + j] = float16_t(p);
                lsum += p;
            }
            float rsum = subgroupClusteredAdd(lsum, 4u);
            float cf = exp(mold - rmax);
            // Every lane of the cluster read mrow[row] above; the barrier-free write is safe
            // because only lane 0 writes and the other three no longer read it.
            subgroupBarrier();
            if ((li % 4u) == 0u) {
                lrow[row] = lrow[row] * cf + rsum;
                mrow[row] = rmax;
                corr[row] = cf;
            }
        }
        barrier();
        // 4. rescale this warp's O rows, then O += P·V
        [[unroll]] for (uint f = 0u; f < NF; f++) {
            for (uint e = 0u; e < uint(oacc[f].length()); e++) {
                oacc[f][e] *= corr[mi * 8u + uint(rmapm[e])];
            }
        }
        [[unroll]] for (uint kk = 0u; kk < BN; kk += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseA> pf;
            coopMatLoad(pf, Ps, mi * 8u * BN + kk, BN, gl_CooperativeMatrixLayoutRowMajor);
            [[unroll]] for (uint f = 0u; f < NF; f++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> vf;
                coopMatLoad(vf, KVs, kk * QS4 + (dh * DPW + f * 16u) / 4u, QS4,
                            gl_CooperativeMatrixLayoutRowMajor);
                oacc[f] = coopMatMulAdd(pf, vf, oacc[f]);
            }
        }
        barrier();
    }

    // Normalize and write: element e of fragment f is row mi*8 + rmap[e], dim dh*DPW + f*16 +
    // cmap[e].
    [[unroll]] for (uint f = 0u; f < NF; f++) {
        for (uint e = 0u; e < uint(oacc[f].length()); e++) {
            uint r = mi * 8u + uint(rmapm[e]);
            uint gr = qr0 + r;
            if (gr < pc.q_len) {
                float l = lrow[r];
                uint d = dh * DPW + f * 16u + uint(cmapm[e]);
                o[(gr * pc.nh + h) * HD + d] = (l > 0.0) ? oacc[f][e] / l : 0.0;
            }
        }
    }
}
