#version 460
// Elementwise sigmoid gate: y[i] = a[i] * sigmoid(b[i]). qwen35 attention output gate.
// gate_stride/gate_row_width/gate_block_width: interleaved gate read.
// gate_block_width > 0: each head block width, gate at offset gate_row_width within block.
// gate_stride > 0 && gate_block_width == 0: per-row strided gate read.
// Both 0: flat gate read.
// -DQ8 build (`mul_sigmoid_q8`, decode): also writes quant_q8(y) into qa/dact/sact for the int8
// GEMV that reads y next (the attention output projection), which then skips its own `quant_q8`
// dispatch — see silu_mul.comp's -DQ8 doc (requiredSubgroupSize=32, host gates n % 32 == 0).
#ifdef Q8
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(push_constant) uniform PC {
    uint n; uint gate_stride; uint gate_row_width; uint gate_block_width;
} pc;
layout(binding = 0) readonly buffer AB { float a[]; };
layout(binding = 1) readonly buffer BB { float b[]; };
layout(binding = 2) writeonly buffer YB { float y[]; };
#ifdef Q8
layout(binding = 3) writeonly buffer QBuf { int8_t qa[]; };
layout(binding = 4) writeonly buffer DBuf { float16_t dact[]; };
layout(binding = 5) writeonly buffer SBuf { float16_t sact[]; };
#endif

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }

    float g;
    if (pc.gate_block_width > 0u) {
        uint total_cols = pc.gate_stride / 2u;
        uint headw = pc.gate_block_width / 2u; // per-head gate width (=hd)
        uint r = i / total_cols;
        uint c = i % total_cols;
        uint head = c / headw;
        uint off = c % headw;
        g = b[r * pc.gate_stride + head * pc.gate_block_width + headw + off];
    } else if (pc.gate_stride > 0u) {
        uint r = i / pc.gate_row_width;
        uint c = i % pc.gate_row_width;
        g = b[r * pc.gate_stride + c];
    } else {
        g = b[i];
    }
    float v = a[i] / (1.0 + exp(-g));
    y[i] = v;
#ifdef Q8
    // quant_q8.comp's per-block math (element i = block * 32 + lane).
    float amax = subgroupMax(abs(v));
    float d = amax / 127.0;
    float inv = (amax > 0.0) ? 1.0 / d : 0.0;
    int q = int(round(v * inv));
    q = clamp(q, -127, 127);
    qa[i] = int8_t(q);
    float sq = subgroupAdd(d * float(q));
    if (subgroupElect()) {
        dact[i >> 5u] = float16_t(d);
        sact[i >> 5u] = float16_t(sq);
    }
#endif
}
