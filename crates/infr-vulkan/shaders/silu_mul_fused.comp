#version 460
// Fused gated-GLU over a combined gate||up buffer gu[rows, 2*nff]:
// y[r,i] = act(gu[r,i]) * gu[r, nff+i]. One thread per output element.
// Default act = SiLU (SwiGLU); -DGELU = GELU tanh-approx (GeGLU, used by gemma).
// do_clamp/limit: DeepSeek V4's per-layer SwiGLU clamp — see shaders/silu_mul.comp for the
// arithmetic and for why `do_clamp == 0` leaves every other model's numerics untouched.
// -DQ8 build (`silu_mul_fused_q8`, rows == 1 decode, SiLU only): also writes quant_q8(y) into qa/dact/sact
// (`quant_q8.comp`'s layout) for the int8 GEMV that reads y next, which then skips its own
// `quant_q8` dispatch. Each wave32 (requiredSubgroupSize=32; the host gates n % 32 == 0, so a wave
// is one whole 32-element block, entirely in or out of range) runs quant_q8's math on the 32
// values it just stored.
#ifdef Q8
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC { uint rows; uint nff; uint do_clamp; float limit; } pc;
layout(binding = 0) readonly buffer GU { float gu[]; };
layout(binding = 1) buffer YB { float y[]; };
#ifdef Q8
layout(binding = 2) writeonly buffer QBuf { int8_t qa[]; };
layout(binding = 3) writeonly buffer DBuf { float16_t dact[]; };
layout(binding = 4) writeonly buffer SBuf { float16_t sact[]; };
#endif
#ifdef Q8
// quant_q8.comp's per-block math on this wave's 32 values (element i = block * 32 + lane).
void quant_block(uint i, float v) {
    float amax = subgroupMax(abs(v));
    float d = amax / 127.0;
    float inv = (amax > 0.0) ? 1.0 / d : 0.0;
    int q = int(round(v * inv));
    q = clamp(q, -127, 127);
    qa[i] = int8_t(q);
    float s = subgroupAdd(d * float(q));
    if (subgroupElect()) {
        dact[i >> 5u] = float16_t(d);
        sact[i >> 5u] = float16_t(s);
    }
}
#endif

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rows * pc.nff) { return; }
    uint r = idx / pc.nff;
    uint i = idx % pc.nff;
    uint base = r * 2u * pc.nff;
    float g = gu[base + i];
    if (pc.do_clamp != 0u) { g = min(g, pc.limit); }
#ifdef GELU
    // gelu_pytorch_tanh: 0.5*g*(1+tanh(sqrt(2/pi)*(g+0.044715*g^3)))
    float a = 0.5 * g * (1.0 + tanh(0.7978845608028654 * (g + 0.044715 * g * g * g)));
#else
    float a = g / (1.0 + exp(-g));
#endif
    float u = gu[base + pc.nff + i];
    if (pc.do_clamp != 0u) { u = clamp(u, -pc.limit, pc.limit); }
    float v = a * u;
    y[idx] = v;
#ifdef Q8
    quant_block(idx, v);
#endif
}
