#version 460
// Gated-GLU with SEPARATE gate/up buffers: y[i] = act(gate[i]) * up[i]. One thread/element.
// Default act = SiLU (SwiGLU). -DGELU = GELU tanh-approx (GeGLU) — gemma4's per-layer-embd gate.
// up_off/up_stride/row_width: strided read from `up` buffer (E2B per-layer embedding).
// gate_stride/gate_row_width/gate_block_width: interleaved or strided gate read.
//   gate_block_width > 0: each head's block occupies gate_block_width elements (qwen35 q+g layout).
//     Gate starts at offset gate_row_width within each block. gate_stride = per-row stride.
//   gate_block_width == 0 && gate_stride > 0: simple per-row strided gate read.
//   gate_block_width == 0 && gate_stride == 0: flat gate read.
// do_clamp/limit: DeepSeek V4's per-layer SwiGLU clamp — y = act(min(g, limit)) * clamp(u, -limit,
// limit). The gate bound is ONE-SIDED and applied BEFORE the activation (V4 clamps pre-SiLU where
// every other arch clamps post-SiLU); `up` is clamped symmetrically. `do_clamp == 0` (every model
// but V4) takes the identical instruction sequence this kernel had before the field existed — the
// branch is uniform across the whole dispatch (a push constant).
// -DQ8 build (`silu_mul_q8`, rows == 1 decode, SiLU only): also writes quant_q8(y) into qa/dact/sact
// (`quant_q8.comp`'s layout) for the int8 GEMV that reads y next, which then skips its own
// `quant_q8` dispatch. Each wave32 (requiredSubgroupSize=32; the host gates n % 32 == 0, so a wave
// is one whole 32-element block, entirely in or out of range) runs quant_q8's math on the 32
// values it just stored.
#ifdef Q8
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
// -DY16 (prefill): also writes an f16 copy of y for the Intel Xe2 `_x256` GEMM that reads it next
// (see rmsnorm.comp's -DY16).
#ifdef Y16
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#endif
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PC {
    uint n; uint up_off; uint up_stride; uint row_width;
    uint gate_stride; uint gate_row_width; uint gate_block_width;
    uint do_clamp; float limit;
} pc;
layout(binding = 0) readonly buffer GB { float gate[]; };
layout(binding = 1) readonly buffer UB { float up[]; };
layout(binding = 2) buffer YB { float y[]; };
#ifdef Y16
layout(binding = 3) writeonly buffer Y16B { float16_t y16[]; };
#endif
#ifdef Q8
layout(binding = 3) writeonly buffer QBuf { int8_t qa[]; };
layout(binding = 4) writeonly buffer DBuf { float16_t dact[]; };
layout(binding = 5) writeonly buffer SBuf { float16_t sact[]; };
#endif
#ifdef Q8
// quant_q8.comp's per-block math on this wave's 32 values (element i = block * 32 + lane).
void quant_block(uint i, float v) {
    float amax = subgroupMax(abs(v));
    float d = amax / 127.0;
    float inv = (amax > 0.0) ? 1.0 / d : 0.0;
    int q = int(round(v * inv));
    q = clamp(q, -127, 127);
    qa[i] = int8_t(q);
    float s = subgroupAdd(d * float(q));
    if (subgroupElect()) {
        dact[i >> 5u] = float16_t(d);
        sact[i >> 5u] = float16_t(s);
    }
}
#endif

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }

    float g;
    if (pc.gate_block_width > 0u) {
        uint nff = pc.row_width;
        uint headw = pc.gate_block_width / 2u;
        uint gr = i / nff;
        uint gc = i % nff;
        uint head = gc / headw;
        uint off = gc % headw;
        g = gate[gr * pc.gate_stride + head * pc.gate_block_width + headw + off];
    } else if (pc.gate_stride > 0u) {
        uint gr = i / pc.gate_row_width;
        uint gc = i % pc.gate_row_width;
        g = gate[gr * pc.gate_stride + gc];
    } else {
        // Flat gate read
        g = gate[i];
    }

    if (pc.do_clamp != 0u) { g = min(g, pc.limit); }
#ifdef GELU
    float a = 0.5 * g * (1.0 + tanh(0.7978845608028654 * (g + 0.044715 * g * g * g)));
#else
    float a = g / (1.0 + exp(-g));
#endif
    uint up_idx;
    if (pc.up_stride == 0u) {
        up_idx = pc.up_off + i;
    } else {
        uint r = i / pc.row_width;
        uint c = i % pc.row_width;
        up_idx = pc.up_off + r * pc.up_stride + c;
    }
    float u = up[up_idx];
    if (pc.do_clamp != 0u) { u = clamp(u, -pc.limit, pc.limit); }
    float v = a * u;
    y[i] = v;
#ifdef Y16
    y16[i] = float16_t(v);
#endif
#ifdef Q8
    quant_block(i, v);
#endif
}
